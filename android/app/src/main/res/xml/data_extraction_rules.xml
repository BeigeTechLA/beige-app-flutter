<?xml version="1.0" encoding="utf-8"?>
<!--
  Disables cloud backup and device-to-device transfer of app data.
  Prevents auth token in SharedPreferences from being restored on
  reinstall, which would otherwise route returning users straight
  into a logged-in state with a stale token.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
